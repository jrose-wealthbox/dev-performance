#!/usr/bin/env ruby

require "date"
require "time"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "devperf/github_client"
require "devperf/collector"
require "devperf/metrics"
require "devperf/report"

module DevPerf
  USAGE = <<~USAGE
    Usage:
      bin/devperf login=<github-login> repo=<owner/name> days=<N>
      bin/devperf login=<github-login> repo=<owner/name> from=<YYYY-MM-DD> to=<YYYY-MM-DD>

    Date ranges are inclusive UTC calendar dates. `days=N` includes today and the
    preceding N-1 dates. GitHub CLI (`gh`) must be installed and authenticated.
  USAGE

  module_function

  def parse_arguments(argv, today: Time.now.utc.to_date)
    return { help: true } if argv == ["--help"] || argv == ["help"]

    values = {}
    argv.each do |argument|
      match = argument.match(/\A([a-z]+)=(.+)\z/)
      raise ArgumentError, "Expected key=value argument: #{argument}" unless match

      key, value = match.captures
      raise ArgumentError, "Unknown argument: #{key}" unless %w[login repo days from to].include?(key)
      raise ArgumentError, "Argument supplied more than once: #{key}" if values.key?(key)

      values[key] = value
    end

    login = values["login"]
    repo = values["repo"]
    raise ArgumentError, "login=<github-login> is required" unless login
    raise ArgumentError, "repo=<owner/name> is required" unless repo
    raise ArgumentError, "Invalid GitHub login: #{login}" unless login.match?(/\A[a-zA-Z0-9-]{1,39}\z/)
    unless repo.match?(/\A[a-zA-Z0-9-]+\/[a-zA-Z0-9._-]+\z/)
      raise ArgumentError, "repo must be written as owner/name"
    end

    if values.key?("days")
      raise ArgumentError, "Use either days or from/to, not both" if values.key?("from") || values.key?("to")
      raise ArgumentError, "days must be a positive integer" unless values["days"].match?(/\A\d+\z/)

      days = values["days"].to_i
      raise ArgumentError, "days must be a positive integer" unless days.positive?

      from = today - days + 1
      to = today
    else
      raise ArgumentError, "Provide either days=N or both from and to" unless values.key?("from") && values.key?("to")

      from = parse_date(values["from"], "from")
      to = parse_date(values["to"], "to")
      raise ArgumentError, "from must be on or before to" if from > to
    end

    { login: login, repo: repo, from: from, to: to }
  end

  def parse_date(value, name)
    raise ArgumentError, "#{name} must use YYYY-MM-DD" unless value.match?(/\A\d{4}-\d{2}-\d{2}\z/)

    Date.iso8601(value)
  rescue Date::Error
    raise ArgumentError, "#{name} is not a valid date: #{value}"
  end

  def run(argv = ARGV)
    options = parse_arguments(argv)
    if options[:help]
      puts USAGE
      return 0
    end

    client = GitHubClient.new
    activity = Collector.new(client).collect(repo: options[:repo], from: options[:from], to: options[:to])
    rows = Metrics.new(activity, options[:login]).rows
    puts Report.render(rows, login: options[:login], repo: options[:repo], from: options[:from], to: options[:to])
    0
  rescue ArgumentError, Error => error
    warn "devperf: #{error.message}"
    warn USAGE unless error.is_a?(Error)
    1
  end
end

exit DevPerf.run if $PROGRAM_NAME == __FILE__
